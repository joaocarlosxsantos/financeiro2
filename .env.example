# ---------------------------------------------------------------------
# Banco de dados (Postgres)
# DATABASE_URL: string de conexão (com pooling, se o provedor oferecer)
# DIRECT_URL:   conexão direta, usada só pelas migrations
# ---------------------------------------------------------------------
# Desenvolvimento local, usando o banco do docker-compose.yml:
DATABASE_URL="postgresql://postgres:financeiro@localhost:5432/financeiro"
DIRECT_URL="postgresql://postgres:financeiro@localhost:5432/financeiro"

# Em produção (Neon, Supabase, Vercel Postgres), troque pelas URLs do provedor:
# DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# ---------------------------------------------------------------------
# Autenticação (Auth.js v5)
# Gere com:  npx auth secret     ou     openssl rand -base64 32
# ---------------------------------------------------------------------
AUTH_SECRET="troque-por-uma-chave-aleatoria-de-32-bytes"

# Em produção na Vercel, defina a URL pública do projeto:
# AUTH_URL="https://seu-projeto.vercel.app"

# ---------------------------------------------------------------------
# Docker (opcional) — variáveis lidas pelo docker-compose.yml
# Descomente só se quiser mudar os padrões. Se mudar senha ou porta,
# atualize também as URLs lá em cima.
# ---------------------------------------------------------------------
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="financeiro"
# POSTGRES_DB="financeiro"
# POSTGRES_PORT="5432"
