# ---------------------------------------------------------------------
# Banco de dados (Postgres)
# Neon, Supabase, Vercel Postgres — qualquer um serve.
# DATABASE_URL: string de conexão (com pooling, se o provedor oferecer)
# DIRECT_URL:   conexão direta, usada só pelas migrations
# ---------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@host:5432/financeiro?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host:5432/financeiro?sslmode=require"

# ---------------------------------------------------------------------
# Autenticação (Auth.js v5)
# Gere com:  npx auth secret     ou     openssl rand -base64 32
# ---------------------------------------------------------------------
AUTH_SECRET="troque-por-uma-chave-aleatoria-de-32-bytes"

# Em produção na Vercel, defina a URL pública do projeto:
# AUTH_URL="https://seu-projeto.vercel.app"
