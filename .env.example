# ---------------------------------------------------------------------
# Banco de dados (Postgres)
# DATABASE_URL: string de conexão (com pooling, se o provedor oferecer)
# DIRECT_URL:   conexão direta, usada só pelas migrations
# ---------------------------------------------------------------------
# Desenvolvimento local, usando o banco do docker-compose.yml:
DATABASE_URL="postgresql://postgres:financeiro@localhost:5432/financeiro"
DIRECT_URL="postgresql://postgres:financeiro@localhost:5432/financeiro"

# Em produção (Neon, Supabase, Vercel Postgres), troque pelas URLs do provedor:
# DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# ---------------------------------------------------------------------
# Autenticação (Auth.js v5)
# Gere com:  npx auth secret     ou     openssl rand -base64 32
# ---------------------------------------------------------------------
AUTH_SECRET="troque-por-uma-chave-aleatoria-de-32-bytes"

# Em produção na Vercel, defina a URL pública do projeto:
# AUTH_URL="https://seu-projeto.vercel.app"

# ---------------------------------------------------------------------
# Docker (opcional) — variáveis lidas pelo docker-compose.yml
# Descomente só se quiser mudar os padrões. Se mudar senha ou porta,
# atualize também as URLs lá em cima.
# ---------------------------------------------------------------------
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="financeiro"
# POSTGRES_DB="financeiro"
# POSTGRES_PORT="5432"
# Open Finance: base64 de uma chave aleatória de 32 bytes (gerar fora do repositório).
APP_ENCRYPTION_KEY=

# Open Finance via Pluggy Connect (servidor): credenciais do app Pluggy.
# Nunca preencher valores reais neste arquivo nem usar NEXT_PUBLIC_.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Lista de IDs de usuários autorizados a usar a integração pessoal (separados por vírgula; vazio = ninguém).
OPEN_FINANCE_ALLOWED_USER_IDS=

# Telegram B1: token obtido no BotFather; segredo aleatório para setWebhook.
# Nunca usar NEXT_PUBLIC_ ou preencher valores reais neste arquivo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# B2: autenticação do Vercel Cron (Bearer).
CRON_SECRET=
# B3: perguntas livres opcionais. Sem chaves, comandos/insights por regra continuam.
# AI_PROVIDER: gemini ou anthropic. Vazio: Gemini se houver GEMINI_API_KEY,
# senão Anthropic se houver ANTHROPIC_API_KEY; sem nenhuma chave, IA desligada.
AI_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
